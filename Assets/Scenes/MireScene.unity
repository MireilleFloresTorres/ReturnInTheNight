  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "INFORME DE EVALUACI\xD3N PSICOL\xD3GICA\r\nPaciente: Daniel \r\nEdad:
    28 a\xF1os\r\n\r\nMotivo de consulta:\r\nEl paciente presenta episodios de p\xE9rdida
    de memoria, dificultad para recordar eventos recientes y la percepci\xF3n de
    cambios inexplicables en su entorno personal.\r\n\r\nObservaciones:\r\nSe identifican
    episodios de desorientaci\xF3n temporal, inconsistencias entre sus recuerdos
    y la evidencia registrada, as\xED como referencias recurrentes a un individuo
    llamado \u201CZack\u201D, descrito por el paciente como una persona independiente.\r\n\r\nDiagn\xF3stico
    presuntivo:\r\nTrastorno de Identidad Disociativo (TID).\r\nLa evaluaci\xF3n
    sugiere la presencia de estados de identidad diferenciados acompa\xF1ados de
    periodos de amnesia disociativa.\r\n\r\nObservaci\xF3n final:\nEl paciente afirma
    convivir con otra persona en su domicilio; sin embargo, no existen registros
    que confirmen la presencia de un segundo individuo.\nDocumento Confidencial --\nDocumento
    confidencial confirmen la presencia de un segundo individuo.\r\n\r\n**Documento
    confidencial**\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 3622828cf135dbd4c9cdf11b54f4d4d4, type: 2}
